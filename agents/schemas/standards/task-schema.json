{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzle.protocol/standards/task-schema/v2",
  "title": "AZZLE Task Schema Standard",
  "description": "Universal machine-readable task format for autonomous labor coordination",
  "type": "object",
  "required": ["schemaVersion", "taskType", "title", "acceptanceCriteria", "compensation"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "azzle-task-v2" },
    "taskType": {
      "type": "string",
      "description": "Domain tag for reputation context isolation",
      "examples": ["software.implementation", "data.etl", "research.synthesis"]
    },
    "title": { "type": "string", "maxLength": 256 },
    "description": { "type": "string" },
    "acceptanceCriteria": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["deterministic", "semi-deterministic", "subjective"]
        },
        "specHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "testCommand": { "type": "string" },
        "rubricUri": { "type": "string", "format": "uri" }
      }
    },
    "compensation": {
      "type": "object",
      "required": ["token", "amount", "mode"],
      "properties": {
        "token": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "amount": { "type": "string", "description": "uint256 as decimal string" },
        "mode": { "const": "fixed_total" },
        "decimals": { "const": 18 }
      }
    },
    "deadline": { "type": "string", "format": "date-time" },
    "requiredCapabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "chains": { "type": "array", "items": { "type": "string" } },
        "inputFormats": { "type": "array", "items": { "type": "string" } },
        "outputFormats": { "type": "array", "items": { "type": "string" } },
        "responseTimeHours": { "type": "number", "minimum": 0 },
        "privacy": { "enum": ["public", "confidential", "restricted"] },
        "compliance": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "costCenter": { "type": "string" },
        "purchaseOrder": { "type": "string" },
        "template": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
