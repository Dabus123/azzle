pragma solidity ^0.8.24;

interface ITaskPartiesV2 {
    function taskParties(uint256 taskId) external view returns (address poster, address worker);
}

/// @notice Immutable onchain scope publication for AZL V2 tasks.
/// @dev Only the task poster recorded by TaskRegistryV2 can publish, and only once.
contract TaskScopeRegistryV2 {
    address public immutable taskRegistry;
    mapping(uint256 => string) private _scopes;

    event ScopePublished(uint256 indexed taskId, bytes32 indexed scopeHash, string scope);

    constructor(address _taskRegistry) {
        require(_taskRegistry.code.length != 0, "TSv2: registry");
        taskRegistry = _taskRegistry;
    }

    function publish(uint256 taskId, string calldata scope) external {
        (address poster,) = ITaskPartiesV2(taskRegistry).taskParties(taskId);
        require(msg.sender == poster && bytes(scope).length > 0 && bytes(scope).length <= 8_192, "TSv2: scope");
        require(bytes(_scopes[taskId]).length == 0, "TSv2: published");
        _scopes[taskId] = scope;
        emit ScopePublished(taskId, keccak256(bytes(scope)), scope);
    }

    function scopeOf(uint256 taskId) external view returns (string memory) { return _scopes[taskId]; }
}