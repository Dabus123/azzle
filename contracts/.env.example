# RPC (required for mainnet/base/arbitrum deploy)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Deployer (never commit real keys)
DEPLOYER_PRIVATE_KEY=0x...

# Treasury fee recipient — only this address can call TreasuryRouter.withdrawFees
FEE_RECIPIENT=0x...

# Etherscan API v2 — one key for all chains (create at https://etherscan.io/apidashboard)
# Legacy BaseScan-only keys no longer work for verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Optional alias (same value as ETHERSCAN_API_KEY)
# BASESCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional override (defaults per network in deploy-mainnet.ts)
# USDC_ADDRESS=0xA0b86991c6318bA39c0478dD3bD4aA7024928cFc8

# Live AZZLE token on Base — see contracts/deployments/base-8453.json
AZL_TOKEN_ADDRESS=0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3

# Resume deploy only (after EscrowVault + TaskRegistry + setTaskRegistry)
# ESCROW_VAULT_ADDRESS=0xd1f3058650ab22250d139dba5b2b48118071dc36
# TASK_REGISTRY_ADDRESS=0x0a47c3a2d515ec3a23f225a7bac1b0a1654e4d48

# Finish wiring (all six contracts deployed — run deploy:list-contracts for addresses)
# REPUTATION_REGISTRY_ADDRESS=0x...
# ARBITRATION_MODULE_ADDRESS=0x...
# TREASURY_ROUTER_ADDRESS=0x...
# AGENT_DEPOSIT_VAULT_ADDRESS=0x...
