# RPC (required for mainnet/base/arbitrum deploy)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Deployer (never commit real keys)
DEPLOYER_PRIVATE_KEY=0x...

# Treasury fee recipient — only this address can call TreasuryRouter.withdrawFees
FEE_RECIPIENT=0x...

# Required, explicit operational roles (no deploy-script defaults)
BUYBACK_EXECUTOR=0x...
FALLBACK_RESOLVER=0x...

# Post-deployment governance owner (recommended: Safe multisig, distinct from
# BUYBACK_EXECUTOR). Used by npm run ownership:transfer -- --network base.
# PROTOCOL_OWNER=0x...
# ALLOW_EOA_PROTOCOL_OWNER=true # unsafe escape hatch; omitted by default
# DEPLOYER_ADDRESS=0x... # required by finish/candidate generation when signer metadata is unavailable

# Etherscan API v2 — one key for all chains (create at https://etherscan.io/apidashboard)
# Legacy BaseScan-only keys no longer work for verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Optional alias (same value as ETHERSCAN_API_KEY)
# BASESCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional override (defaults per network in deploy-mainnet.ts)
# USDC_ADDRESS=0xA0b86991c6318bA39c0478dD3bD4aA7024928cFc8

# Live AZZLE token on Base — see contracts/deployments/base-8453.json
AZL_TOKEN_ADDRESS=0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3

# Resume deploy only: these must be a mutually-bound fresh pair. Resume refuses
# TaskRegistry/EscrowVault mismatches to prevent an unsafe mixed deployment graph.
# ESCROW_VAULT_ADDRESS=0x...
# TASK_REGISTRY_ADDRESS=0x...

# Finish/preflight/inspect complete wiring (run deploy:list-contracts for addresses)
# REPUTATION_REGISTRY_ADDRESS=0x...
# ARBITRATION_MODULE_ADDRESS=0x...
# ARBITRATION_SATELLITE_ADDRESS=0x...  # optional for finish (deploys if unset); recover reads from chain if omitted
# TREASURY_ROUTER_ADDRESS=0x...
# AGENT_DEPOSIT_VAULT_ADDRESS=0x...
# ARBITRATION_RECOVERY_COORDINATOR_ADDRESS=0x...
# UNION_STAKING_VAULT_ADDRESS=0x...
# TASK_SCOPE_REGISTRY_ADDRESS=0x...

# Full and resume always deploy all ten suite contracts (including ArbitrationSatellite
# wiring), plus TaskScopeRegistry. Finish/preflight/inspect require all ten addresses.
# finish validates bytecode plus the complete constructor/one-shot graph, then
# writes a candidate only; canonical deployments/base-8453.json is not overwritten.
# CANDIDATE_MANIFEST_PATH=deployments/base-8453.candidate.json
#
# Promotion is dry-run by default:
#   npm run manifest:promote:dry
# Apply only after review (archives canonical, then syncs schema-compatible consumers):
#   npm run manifest:promote
#
# Read-only old-suite retirement check (defaults to canonical manifest):
# OLD_SUITE_MANIFEST=deployments/base-8453.previous.json
#   npm run suite:old:empty
# Mapping-backed balances that cannot be enumerated are reported as limitations.

# Staking deploys inactive. Set only for an intentional launch-time activation.
# ACTIVATE_STAKING=true

# AZL-only V2 atomic deployment
# Existing protocol Safe; override only with the reviewed V2 governance Safe.
# V2_GOVERNANCE_SAFE=0xB459145b74Ca4B198f73C0d573a161e85CA76D27
# Required explicit AZL burn destination.
# V2_BURN_RECIPIENT=0x...
# Required comma-separated initial arbitrator panel. Members must bond AZL before disputes can open.
# V2_INITIAL_PANEL=0x...,0x...,0x...
# Read-only preflight and CREATE2/gas report without factory deployment.
# V2_DRY_RUN=1