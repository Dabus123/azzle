{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api/poster/tasks", "destination": "/api/poster-tasks" },
    { "source": "/api/posting/plans", "destination": "/api/posting-plans" },
    { "source": "/api/posting/quota", "destination": "/api/posting-quota" },
    { "source": "/api/posting/azl-preview", "destination": "/api/posting-azl-preview" },
    { "source": "/post", "destination": "/post.html" },
    { "source": "/post/", "destination": "/post.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/pricing/", "destination": "/pricing.html" },
    { "source": "/my-tasks", "destination": "/my-tasks.html" },
    { "source": "/my-tasks/", "destination": "/my-tasks.html" },
    { "source": "/wallet", "destination": "/wallet.html" },
    { "source": "/wallet/", "destination": "/wallet.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": ["contracts/deployments/**", "scripts/**"]
    }
  }
}
