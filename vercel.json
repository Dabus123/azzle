{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api/posting/azl-preview", "destination": "/api/get-azl-preview" },
    { "source": "/api/posting/quota", "destination": "/api/get-posting-quota" },
    { "source": "/api/posting/check", "destination": "/api/posting-check" },
    { "source": "/api/posting/record", "destination": "/api/posting-record" },
    { "source": "/api/posting/upgrade", "destination": "/api/posting-upgrade" },
    { "source": "/api/posting/quote", "destination": "/api/posting-quote" },
    { "source": "/api/poster/tasks", "destination": "/api/get-poster-tasks" },
    { "source": "/api/market/open", "destination": "/api/get-open-tasks" },
    { "source": "/api/market/recent", "destination": "/api/get-recent-tasks" },
    { "source": "/api/market/task", "destination": "/api/get-task" },
    { "source": "/api/market/legacy", "destination": "/api/get-legacy-open-tasks" },
    { "source": "/api/union/overview", "destination": "/api/get-union-overview" },
    { "source": "/snap", "destination": "/api/snap" },
    { "source": "/snap/", "destination": "/api/snap" },
    { "source": "/post", "destination": "/post.html" },
    { "source": "/post/", "destination": "/post.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/pricing/", "destination": "/pricing.html" },
    { "source": "/market", "destination": "/market.html" },
    { "source": "/market/", "destination": "/market.html" },
    { "source": "/union", "destination": "/union.html" },
    { "source": "/union/", "destination": "/union.html" },
    { "source": "/my-tasks", "destination": "/my-tasks.html" },
    { "source": "/my-tasks/", "destination": "/my-tasks.html" },
    { "source": "/wallet", "destination": "/wallet.html" },
    { "source": "/wallet/", "destination": "/wallet.html" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/", "destination": "/docs/index.html" },
    { "source": "/getting-started", "destination": "/docs/getting-started.html" },
    { "source": "/getting-started/", "destination": "/docs/getting-started.html" },
    { "source": "/docs/quickstart", "destination": "/docs/quickstart.html" },
    { "source": "/docs/api", "destination": "/docs/api.html" },
    { "source": "/docs/api-reference", "destination": "/docs/api.html" },
    { "source": "/docs/contracts", "destination": "/docs/contracts.html" },
    { "source": "/docs/agents", "destination": "/docs/agent-guide.html" },
    { "source": "/docs/agent-guide", "destination": "/docs/agent-guide.html" },
    { "source": "/docs/authentication", "destination": "/docs/authentication.html" },
    { "source": "/docs/reliability", "destination": "/docs/reliability.html" },
    { "source": "/docs/union-staking", "destination": "/docs/union-staking.html" },
    { "source": "/docs/changelog", "destination": "/docs/changelog.html" },
    { "source": "/docs/support", "destination": "/docs/support.html" },
    { "source": "/docs/examples", "destination": "/docs/examples/index.html" },
    { "source": "/docs/examples/", "destination": "/docs/examples/index.html" },
    { "source": "/docs/examples/curl", "destination": "/docs/examples/curl.html" },
    { "source": "/docs/examples/javascript", "destination": "/docs/examples/javascript.html" },
    { "source": "/docs/use-cases", "destination": "/docs/use-cases/index.html" },
    { "source": "/docs/use-cases/", "destination": "/docs/use-cases/index.html" },
    { "source": "/docs/use-cases/create-and-track-a-task", "destination": "/docs/use-cases/create-and-track-a-task.html" },
    { "source": "/docs/use-cases/integrate-agent-workflows", "destination": "/docs/use-cases/integrate-agent-workflows.html" },
    { "source": "/docs/use-cases/handle-task-failures", "destination": "/docs/use-cases/handle-task-failures.html" },
    { "source": "/docs/api/openapi-intro", "destination": "/docs/api/openapi-intro.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "azzle.org" }],
      "destination": "https://www.azzle.org/",
      "permanent": true
    },
    {
      "source": "/:path((?!snap$)(?!snap/).*)",
      "has": [{ "type": "host", "value": "azzle.org" }],
      "destination": "https://www.azzle.org/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/snap",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept, X-Snap-Payload" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    },
    {
      "source": "/snap/",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept, X-Snap-Payload" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "azzle.org" }],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept, X-Snap-Payload" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
