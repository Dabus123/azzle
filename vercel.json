{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler?path=$1" },
    { "source": "/post", "destination": "/post.html" },
    { "source": "/post/", "destination": "/post.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/pricing/", "destination": "/pricing.html" },
    { "source": "/my-tasks", "destination": "/my-tasks.html" },
    { "source": "/my-tasks/", "destination": "/my-tasks.html" },
    { "source": "/wallet", "destination": "/wallet.html" },
    { "source": "/wallet/", "destination": "/wallet.html" }
  ],
  "functions": {
    "api/handler.js": {
      "maxDuration": 60
    }
  }
}
