# Graph layer (Docker stack — used when AZZLE_FORCE_LITE is not set)
POSTGRES_URL=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=azzleforce
QDRANT_URL=http://localhost:6333

# Nervous system
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=azzle-force

# Site login (Privy dashboard → enable Email + Wallet; allow http://localhost:8080)
PRIVY_APP_ID=
PRIVY_CLIENT_ID=

# Cognition — Bankr LLM Gateway (https://docs.bankr.bot/llm-gateway/models)
BANKR_API_KEY=bk_YOUR_API_KEY
OPENAI_BASE_URL=https://llm.bankr.bot/v1
# Default model for all tiers (prepended); per-tier: AZZLE_LLM_MODEL_CHEAP|MEDIUM|FRONTIER
# DeepSeek: deepseek-v4-flash (fast) | deepseek-v4-pro (stronger) | deepseek-v3.2
AZZLE_LLM_MODEL=deepseek-v4-flash
# Max parallel LLM calls when running lite:all (default 2 — raises 429 risk if higher)
# AZZLE_LLM_MAX_CONCURRENT=2

# Content Studio — trailers OFF by default (opt-in only)
# AZZLE_TRAILER_ENABLED=true
# AZZLE_OUTPUTS_DIR=./outputs
# AZZLE_LOGO_MARK=../site/azzlelogo.png
# AZZLE_LOGO_ICON=./azzlelogo.png
# AZZLE_LOGO_TYPE=../site/azzletype.png
# Visual style for Content Studio trailers (Enter the Void / Gaspar Noé default)
# AZZLE_STYLE_DIRECTION=./config/content/style-direction.json
# AZZLE_STYLE_DIRECTION_OFF=true
# AZZLE_TRAILER_INTERVAL_MS=7200000
# AZZLE_TRAILER_MAX_PER_DAY=4
# Requires ffmpeg in PATH for MP4 encoding

# Tools — azzleforce account; needs Contents write on target repo (repo scope to auto-create)
GITHUB_TOKEN=
# Human Terminal miniapp → GitHub Pages (azzleforce account)
#   azzleforce/azzleforce → https://azzleforce.github.io/azzleforce/
# GITHUB_PAGES_REPO=azzleforce/azzleforce
# GITHUB_PAGES_BRANCH=main
# GITHUB_PAGES_BASE_URL=https://azzleforce.github.io/azzleforce/
# AZZLE_MINIAPP_URL=https://azzleforce.github.io/azzleforce/
# Farcaster Snap — production on www.azzle.org (api/snap). Use www — apex redirects break CORS.
# AZZLE_SNAP_PUBLIC_URL=https://www.azzle.org/snap
# AZZLE_SNAP_PORT=4026
# AZZLE_FORCE_SHIP=1
# AZZLE_SHIP_ENABLED=true

# AZZLE protocol (optional — enriches Opportunity Hunter + Onboarding)
AZZLE_SUBGRAPH_URL=
BASE_RPC_URL=https://mainnet.base.org

# Site posting tiers — USDC payments for Basic/Premium/Enterprise (defaults to manifest feeRecipient)
# AZZLE_BILLING_WALLET=0xYourTreasuryAddress
# Optional AZL/USD override when DexScreener is unavailable (dev only)
# AZL_USD_PRICE=0.0000008592

# Operations — dev.json lowers outreach gates (50 entities, 0.5 score threshold)
AZZLE_FORCE_WAVE=1
AZZLE_FORCE_CONFIG=./config/dev.json
# Optional override (default.json uses 0.75; dev.json uses 0.5)
# AZZLE_PROBABILITY_THRESHOLD=0.5
HUMAN_APPROVE_OUTREACH=false

# No Docker? Lite mode — file-backed graph in .azzle-force-lite/
# AZZLE_FORCE_LITE=true

# Set false to skip X DMs. Valid tokens still need X API credits for user lookup/DMs (402 = add credits at developer.x.com).
# OUTREACH_PREFER_EMAIL=true  — only draft entities with email: (recommended; org X accounts block DMs)

# Email — pick one provider (auto-detects RESEND_API_KEY or SMTP_HOST)
# OUTREACH_EMAIL_PROVIDER=resend
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=
OUTREACH_SITE_URL=
# Product marketing context for outreach/Farcaster LLM prompts (default: ../.agents/product-marketing.md)
# AZZLE_PRODUCT_MARKETING_PATH=../.agents/product-marketing.md
# Max outbound emails per UTC day (Resend free tier ~100). Prevents 429 retry storms.
# OUTREACH_DAILY_EMAIL_CAP=90
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_WEBHOOK_PORT=4025
# OUTREACH_REPLY_TO=replies@azzle.org
# Point Resend webhook to: https://your-tunnel/webhooks/resend (or localhost via ngrok)

# SMTP (Gmail app password, SendGrid SMTP, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=onboarding@yourdomain.com
# SMTP_SECURE=false

# X / Twitter DMs — OAuth 2 user token (recommended) OR OAuth 1.0a user context
# Developer portal: dm.read + dm.write scopes; Elevated access required for DMs


# Add contacts to graph entities as contact_methods:
#   email:founder@example.com
#   x:handle  or  https://x.com/handle

# Reddit autopost — thread hunting + value comments + demo posts (wave 3)
# Create app at reddit.com/prefs/apps (script type — often blocked; see Responsible Builder Policy)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_REFRESH_TOKEN=
# REDDIT_AUTOPOST=true
# REDDIT_USER_AGENT=azzle-force:expansion:1.0 (by /u/yourusername)
# Subs + queries: config/reddit.json

# Farcaster swarm autopost — Neynar (recommended over Reddit)
# 1. dev.neynar.com → create app → Create Agent → copy signer_uuid
# 2. Same app's API key → NEYNAR_API_KEY
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
FARCASTER_AUTOPOST=true
# FARCASTER_CAST_INTERVAL_MS=14400000
# Channels + rules: config/farcaster.json

# ── Vercel (azzle.org production) ──
# Connect repo at vercel.com → add env vars below → Storage → Redis (Upstash)
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN are auto-injected when linked.
# Posting tiers/quotes persist in Redis on Vercel; locally they use azzle-force/data/*.json
# Privy dashboard: add https://azzle.org (and preview URLs) to allowed origins
