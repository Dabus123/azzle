# Graph layer (Docker stack — used when AZZLE_FORCE_LITE is not set)
POSTGRES_URL=postgres://azzle:azzle@localhost:5432/azzle_force
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=azzleforce
QDRANT_URL=http://localhost:6333

# Nervous system
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=azzle-force

# Site login (Privy dashboard → enable Email + Wallet; allow http://localhost:8080)
PRIVY_APP_ID=
PRIVY_CLIENT_ID=

# Cognition — Bankr LLM Gateway (https://docs.bankr.bot/llm-gateway/models)
BANKR_API_KEY=bk_YOUR_API_KEY
OPENAI_BASE_URL=https://llm.bankr.bot/v1
# Default model for all tiers (prepended); per-tier: AZZLE_LLM_MODEL_CHEAP|MEDIUM|FRONTIER
# DeepSeek: deepseek-v4-flash (fast) | deepseek-v4-pro (stronger) | deepseek-v3.2
AZZLE_LLM_MODEL=deepseek-v4-flash

# Tools
GITHUB_TOKEN=

# AZZLE protocol (optional — enriches Opportunity Hunter + Onboarding)
AZZLE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1754651/azzle-protocol/v0.3
BASE_RPC_URL=https://mainnet.base.org

# Site posting tiers — USDC payments for Basic/Premium/Enterprise (defaults to manifest feeRecipient)
# AZZLE_BILLING_WALLET=0xYourTreasuryAddress
# Optional AZL/USD override when DexScreener is unavailable (dev only)
# AZL_USD_PRICE=0.0000008592

# Operations — dev.json lowers outreach gates (50 entities, 0.5 score threshold)
AZZLE_FORCE_WAVE=1
AZZLE_FORCE_CONFIG=./config/dev.json
# Optional override (default.json uses 0.75; dev.json uses 0.5)
# AZZLE_PROBABILITY_THRESHOLD=0.5
HUMAN_APPROVE_OUTREACH=false

# No Docker? Lite mode — file-backed graph in .azzle-force-lite/
# AZZLE_FORCE_LITE=true

# Set false to skip X DMs. Valid tokens still need X API credits for user lookup/DMs (402 = add credits at developer.x.com).
# OUTREACH_PREFER_EMAIL=true  — only draft entities with email: (recommended; org X accounts block DMs)

# Email — pick one provider (auto-detects RESEND_API_KEY or SMTP_HOST)
# OUTREACH_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_M7yRvPse_K4Aun3o9XpQYZwiUeiQEpPxw
OUTREACH_FROM_EMAIL=onboarding@yourdomain.com
OUTREACH_FROM_NAME=AZZLE.org
OUTREACH_SITE_URL=https://azzle.org

# SMTP (Gmail app password, SendGrid SMTP, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=onboarding@yourdomain.com
# SMTP_SECURE=false

# X / Twitter DMs — OAuth 2 user token (recommended) OR OAuth 1.0a user context
# Developer portal: dm.read + dm.write scopes; Elevated access required for DMs


# Add contacts to graph entities as contact_methods:
#   email:founder@example.com
#   x:handle  or  https://x.com/handle

# ── Vercel (azzle.org production) ──
# Connect repo at vercel.com → add env vars below → Storage → Redis (Upstash)
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN are auto-injected when linked.
# Posting tiers/quotes persist in Redis on Vercel; locally they use azzle-force/data/*.json
# Privy dashboard: add https://azzle.org (and preview URLs) to allowed origins
