{
  "name": "@azzle/force",
  "version": "0.1.0",
  "description": "AZZLE FORCE — distributed expansion organism for AZZLE ecosystem growth",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "azzle-force": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-workflows.mjs",
    "dev": "node --watch dist/cli.js",
    "force": "node dist/cli.js",
    "up": "node scripts/docker-up.mjs",
    "lite": "node scripts/run-lite.mjs",
    "lite:all": "node scripts/run-lite.mjs all",
    "snap-server": "node scripts/snap-server.mjs",
    "ship-terminal": "node dist/cli.js ship-human-terminal",
    "observatory": "node scripts/observatory-server.mjs",
    "recover-graph": "node scripts/recover-graph.mjs",
    "outreach-preview": "node dist/cli.js outreach-preview",
    "trailer": "node dist/cli.js trailer",
    "approve-outreach": "node dist/cli.js approve-outreach",
    "down": "docker compose down",
    "migrate": "node dist/cli.js migrate",
    "funnel": "node dist/cli.js funnel",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "dotenv": "^16.4.0",
    "nats": "^2.29.0",
    "neo4j-driver": "^5.27.0",
    "nodemailer": "^9.0.0",
    "pg": "^8.13.0",
    "sharp": "^0.33.5",
    "twitter-api-v2": "^1.29.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.4.0"
  }
}
